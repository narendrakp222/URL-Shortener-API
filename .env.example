# Server Configuration
PROJECT_NAME="Production URL Shortener API"
API_V1_STR="/api/v1"
BASE_URL="http://localhost:8000"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL with asyncpg)
# For local SQLite dev/testing without Postgres, set: sqlite+aiosqlite:///./url_shortener.db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/url_shortener_db"
